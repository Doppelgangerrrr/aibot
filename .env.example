# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Telegram id администраторов/операторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=111111111

# Необязательно: id группы операторов (начинается с -100...).
# Если не задан, запросы оператора приходят каждому администратору в личку.
OPERATOR_CHAT_ID=

# Модель и глубина размышлений (low | medium | high). Для чата поддержки хватает low.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Папка с базой знаний (.md / .txt)
KNOWLEDGE_DIR=knowledge

# Сколько последних сообщений диалога отправлять модели как контекст
HISTORY_MESSAGES=20

# Не больше N сообщений в минуту от одного пользователя
RATE_LIMIT_PER_MINUTE=10

DB_PATH=aibot.db
